@@ -978,6 +978,27 @@ int argmax_range(const float * data, int n) {
 // The result lives in [0, 1] modulo the +1e-10 epsilon (which
 // matches the reference verbatim, including its slight
 // negative-bias for nearly-uniform distributions).
+// hearsay: the raw joint scores of an emitted token, read off the same
+// token logits token_confidence takes.
+static void token_scores(const float * token_logits, int n_token_classes, int token, int blank, TdtToken & tok) {
+    float max_logit = token_logits[0];
+    float runner_up = -INFINITY;
+    for (int i = 0; i < n_token_classes; ++i) {
+        max_logit = std::max(max_logit, token_logits[i]);
+        if (i != token && i != blank) {
+            runner_up = std::max(runner_up, token_logits[i]);
+        }
+    }
+    double sum_exp = 0.0;
+    for (int i = 0; i < n_token_classes; ++i) {
+        sum_exp += std::exp(static_cast<double>(token_logits[i] - max_logit));
+    }
+    tok.logit           = token_logits[token];
+    tok.blank_logit     = token_logits[blank];
+    tok.runner_up_logit = runner_up;
+    tok.logsumexp       = max_logit + static_cast<float>(std::log(sum_exp));
+}
