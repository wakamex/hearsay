-// Build a std::filesystem::path from UTF-8 bytes. On Windows this
-// converts to the native wide encoding; elsewhere the narrow encoding
-// IS UTF-8 and this is a passthrough. (fs::u8path is the C++17
-// spelling; it is deprecated-but-present under C++20.)
-inline std::filesystem::path path_from_utf8(const char * utf8) {
 #if defined(_WIN32)
-    return std::filesystem::u8path(utf8);
+#    ifndef WIN32_LEAN_AND_MEAN
+#        define WIN32_LEAN_AND_MEAN
+#    endif
+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    include <windows.h>
 #else
-    return std::filesystem::path(utf8);
+#    include <sys/stat.h>
 #endif
-}
 
-inline std::filesystem::path path_from_utf8(const std::string & utf8) {
-    return path_from_utf8(utf8.c_str());
-}
+namespace transcribe {
 
 // Existence pre-check whose ONLY job is to distinguish "the file is
 // not at this path" from every other reason a subsequent open might
@@ -45,13 +44,55 @@ inline std::filesystem::path path_from_utf8(const std::string & utf8) {
 // open will surface a more accurate error than FILE_NOT_FOUND.
 //
 // Deliberately only the not-found outcome (ENOENT / ENOTDIR and their
-// Windows equivalents, which fs::status maps to file_type::not_found)
-// reports absence. Other failures (EACCES, ELOOP, EIO, ...) don't
-// prove the file is missing — only that we can't reach it — so they
-// return true and the caller's open reports the real error.
+// Windows equivalents) reports absence. Other failures (EACCES, ELOOP,
+// EIO, ...) don't prove the file is missing — only that we can't reach
+// it — so they return true and the caller's open reports the real error.
 inline bool path_is_present(const char * utf8_path) {
-    std::error_code ec;
-    return std::filesystem::status(path_from_utf8(utf8_path), ec).type() != std::filesystem::file_type::not_found;
+#if defined(_WIN32)
+    int n = MultiByteToWideChar(CP_UTF8, 0, utf8_path, -1, nullptr, 0);
+    if (n <= 0) {
+        return false;
+    }
+    std::wstring wpath(static_cast<size_t>(n), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, utf8_path, -1, wpath.data(), n);
+    if (GetFileAttributesW(wpath.c_str()) != INVALID_FILE_ATTRIBUTES) {
+        return true;
+    }
+    const DWORD err = GetLastError();
+    return err != ERROR_FILE_NOT_FOUND && err != ERROR_PATH_NOT_FOUND;
+#else
+    struct stat st{};
+    return stat(utf8_path, &st) == 0 || (errno != ENOENT && errno != ENOTDIR);
+#endif
 }
 
+struct BinaryFile {
+    FILE * fp = nullptr;
+
+    explicit BinaryFile(const char * utf8_path) : fp(ggml_fopen(utf8_path, "rb")) {}
+    explicit BinaryFile(const std::string & utf8_path) : BinaryFile(utf8_path.c_str()) {}
+    ~BinaryFile() {
+        if (fp != nullptr) {
+            std::fclose(fp);
+        }
+    }
+
+    BinaryFile(const BinaryFile &)             = delete;
+    BinaryFile & operator=(const BinaryFile &) = delete;
+
+    explicit operator bool() const { return fp != nullptr; }
+
+    bool seek(int64_t offset) {
+#if defined(_WIN32)
+        return fp != nullptr && _fseeki64(fp, offset, SEEK_SET) == 0;
+#else
+        return fp != nullptr && fseeko(fp, static_cast<off_t>(offset), SEEK_SET) == 0;
+#endif
+    }
+
+    size_t read(void * dst, size_t nbytes) {
+        return fp != nullptr ? std::fread(dst, 1, nbytes, fp) : 0;
+    }
+};
+
 }  // namespace transcribe
