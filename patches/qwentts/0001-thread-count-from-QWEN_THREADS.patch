diff --git a/src/backend.h b/src/backend.h
index d73e8d8..63c025a 100644
--- a/src/backend.h
+++ b/src/backend.h
@@ -28,6 +28,12 @@ struct BackendPair {
 // Used for GGML CPU thread count: GEMM shares SIMD units across hyperthreads,
 // so one thread per physical core is optimal.
 static int backend_cpu_n_threads(void) {
+    if (const char * e = std::getenv("QWEN_THREADS")) {
+        int t = std::atoi(e);
+        if (t > 0) {
+            return t;
+        }
+    }
     int n = (int) std::thread::hardware_concurrency() / 2;
     return n > 0 ? n : 1;
 }
@@ -100,7 +106,9 @@ static void qt_ggml_log(enum ggml_log_level level, const char * text, void * use
 static void backend_load(void) {
     static const bool loaded = [] {
         ggml_log_set(qt_ggml_log, nullptr);
+#ifndef QWEN_STATIC
         ggml_backend_load_all();
+#endif
         return true;
     }();
     (void) loaded;
